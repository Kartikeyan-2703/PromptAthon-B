NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://app_user:password@pooler-host:6543/postgres?sslmode=require
DIRECT_URL=postgresql://migration_user:password@direct-host:5432/postgres?sslmode=require
FRONTEND_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=prompthon_session
SESSION_TTL_HOURS=12
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-one-time-bootstrap-password
ADMIN_DISPLAY_NAME=PROMPTHON Administrator
LOG_LEVEL=info
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=prompthon-submissions
SUPABASE_CERTIFICATE_BUCKET=prompthon-certificates
STORAGE_MAX_FILE_BYTES=8388608
